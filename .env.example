# --- 既有專案既有變數（本檔僅列出變數名稱與說明，不可放入真正金鑰） ---
MONGODB_URI=
BLOB_READ_WRITE_TOKEN=

# --- 交通小幫手（/api/transit-assistant）---

# OpenAI 官方 API 金鑰。只能由伺服器端讀取，不可加 NEXT_PUBLIC_ 前綴、不可回傳給瀏覽器。
OPENAI_API_KEY=

# 使用的模型。留空則預設使用低成本、適合簡短文字分類/整理的模型（目前預設 gpt-4o-mini）。
OPENAI_MODEL=

# 選用：OpenAI 呼叫逾時毫秒數，預設 8000。
OPENAI_TIMEOUT_MS=

# 選用：交通小幫手每個 IP 的流量限制（滑動視窗）。未設定則使用預設值（每 60 秒 8 次）。
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# 選用：交通小幫手「解析結果」的快取時間（毫秒），預設 5 分鐘，用來降低重複問題的 OpenAI 費用。
ASSISTANT_CACHE_TTL_MS=

# 選用：若要用 Upstash Redis 做跨伺服器執行個體的可靠流量限制，設定以下兩個變數即可自動啟用；
# 不設定的話，會自動退回單一伺服器執行個體的記憶體流量限制，交通小幫手仍可正常使用。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 民宿的 LINE 聯絡連結，會顯示在交通小幫手的 LINE 聯絡按鈕（含 OpenAI 無法使用時的備援畫面）。
# 會被瀏覽器端讀取，因此必須加 NEXT_PUBLIC_ 前綴；此連結非機密資訊，可公開。
# 範例：https://line.me/R/ti/p/@ali-home
NEXT_PUBLIC_LINE_CONTACT_URL=
